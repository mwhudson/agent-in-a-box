import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import lxd_ai

lxd_ai.run_agent(
    "copilot",
    command="copilot",
    install_cmds=[
        ("Installing Node.js 22 ...",
         ["bash", "-c",
          "curl -fsSL https://deb.nodesource.com/setup_22.x | bash -"
          " && apt-get install -y -q nodejs"]),
        ("Installing copilot ...",
         ["npm", "install", "-g", "@github/copilot"]),
    ],
)
