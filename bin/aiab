# aiab launcher. Symlink this onto your PATH; it finds the repo (the parent of
# this script's real directory), puts it on sys.path, and runs the package.
# Resolving the real path means it works regardless of where the symlink lives.

import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, REPO_ROOT)

from aiab.cli import main

if __name__ == "__main__":
    main()
