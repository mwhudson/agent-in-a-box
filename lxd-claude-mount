# lxd-claude-mount: Mount additional directories into a running lxd-claude session.
#
# Usage:
#   lxd-claude-mount [--or] [--for DIR] [--read-only] DIR [DIR ...]
#
# By default, targets the container for the current directory. Use --for to
# specify a different project directory if running from elsewhere.
# Use --or to target an OpenRouter session container.

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import lxd_ai

parser = argparse.ArgumentParser(
    description="Mount directories into a running lxd-claude session.")
parser.add_argument(
    "--or", dest="use_openrouter", action="store_true",
    help="target an OpenRouter session container (created with lxd-claude --or)")
parser.add_argument(
    "--for", dest="for_dir", metavar="DIR", default=None,
    help="project directory whose container to target (default: current directory)")
parser.add_argument(
    "--read-only", dest="read_only", action="store_true",
    help="mount the directories read-only (container cannot modify them)")
parser.add_argument(
    "dirs", nargs="+", metavar="DIR",
    help="host directories to mount into the container")
args = parser.parse_args()

# Target the same LXD project the session containers were created in.
lxd_ai.use_project(lxd_ai.PROJECT)

prefix = "claude-or" if args.use_openrouter else "claude"
for_dir = os.path.realpath(args.for_dir) if args.for_dir else os.getcwd()
container = lxd_ai.container_name_for_dir(for_dir, prefix=prefix)

if not lxd_ai.container_exists(container):
    sys.exit(f"Error: no container for '{for_dir}' (expected '{container}')")
if lxd_ai.container_status(container) != "RUNNING":
    sys.exit(f"Error: container '{container}' exists but is not running")

for path in args.dirs:
    lxd_ai.add_device(container, os.path.realpath(path),
                      work_prefix=lxd_ai.WORK_PREFIX, readonly=args.read_only)
