#!/usr/bin/python3
# lxd-claude: Run claude in the 'claude' LXD container with the current
# directory (and optionally others) mounted into it.
#
# Usage:
#   lxd-claude [--also DIR]... [-- CLAUDE_ARGS...]
#
# See lxd_ai.py for full details.

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lxd_ai

lxd_ai.main(
    container="claude",
    config_host_dir=os.path.expanduser("~/.local/share/lxd-claude/config"),
    config_container_path="/root/.claude",
    config_device_name="claudeconfig",
    command="/root/.local/bin/claude",
    install_cmds=[
        ("Installing Node.js ...",
         ["bash", "-c",
          "apt-get update -q && apt-get install -y -q nodejs npm"]),
        ("Installing claude ...",
         ["npm", "install", "-g", "@anthropic-ai/claude-code"]),
    ],
)
